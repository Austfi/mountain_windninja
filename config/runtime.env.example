# Mountain WindNinja runtime settings
# Copy to config/runtime.env and edit for your setup.

# Which domain to run (must match a key in config/domains.json)
MWN_DOMAIN_ID=my_area

# Where output files go
MWN_RUNTIME_ROOT=runtime

# Where terrain files (DEM/LCP) live
MWN_STATIC_DATA_ROOT=static_data

# WindNinja and OpenFOAM paths (defaults work inside Docker)
MWN_WINDNINJA_CLI=/usr/local/bin/WindNinja_cli
MWN_OPENFOAM_BASHRC=/opt/openfoam9/etc/bashrc
MWN_PYTHON_BIN=.venv/bin/python

# Default vegetation for DEM-based domains (grass, brush, trees)
# Ignored when using LCP files (which include vegetation data)
MWN_SURFACE_VEGETATION=trees

# OpenTopography API key for DEM downloads
# REQUIRED for: mwn.sh fetch-dem
# Get a free key at https://opentopography.org/ (create account > Dashboard > Request API Key)
CUSTOM_SRTM_API_KEY=

# Synoptic Weather API token (used by mwn.sh synoptic-points and mwn.sh validate)
# Get one at https://customer.synopticdata.com/
MWN_SYNOPTIC_TOKEN=

# OpenFOAM mesh cell count (higher = finer resolution, slower).
# Default ~50K. 100K is a good research baseline for domains < 25 km^2.
# NINJAFOAM_MESH_COUNT=100000

# Google Cloud Storage (optional -- leave disabled if you just want local output)
MWN_GCS_BUCKET=
MWN_GCS_UPLOAD_ENABLED=false
